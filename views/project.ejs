<%- include('partials/header') %>

<div class="container">
    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>

    <h3>Categories</h3>
    <% if (categories && categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project yet.</p>
    <% } %>

    <p>
        <a href="/edit-project/<%= project.project_id %>">Edit Project</a> |
        <a href="/assign-categories/<%= project.project_id %>">Assign Categories</a>
    </p>

    <p><a href="/projects">&larr; Back to Service Projects</a></p>
</div>

<%- include('partials/footer') %>