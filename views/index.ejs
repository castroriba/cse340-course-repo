<%- include('partials/header') %>

<div class="container">
    <h2>Home</h2>
    <p>Welcome to the Service Network platform.</p>

    <% const activeUser = (typeof user !== 'undefined' && user) ? user : ((typeof locals !== 'undefined' && locals.user) ? locals.user : null); %>
    <% if (activeUser && activeUser.role_name === 'admin') { %>
        <p><a href="/users">View Registered Users</a></p>
    <% } %>

    <div class="hero-image" style="margin-top: 20px;">
        <img src="/images/hero.svg" alt="Service Network Home Banner" style="max-width: 100%; height: auto; border-radius: 8px;">
    </div>
</div>

<%- include('partials/footer') %>