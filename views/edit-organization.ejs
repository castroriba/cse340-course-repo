<%- include('partials/header') %>

<div class="container">
    <h2><%= title %></h2>

    <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST">
        <div class="form-group">
            <label for="name">Organization Name</label>
            <input type="text" id="name" name="name" value="<%= organizationDetails.name %>" required maxlength="150">
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4" required><%= organizationDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email</label>
            <input type="email" id="contactEmail" name="contactEmail" value="<%= organizationDetails.contact_email %>" required>
        </div>

        <div class="form-group">
            <label for="logoFilename">Logo Filename</label>
            <input type="text" id="logoFilename" name="logoFilename" value="<%= organizationDetails.logo_url || '' %>">
        </div>

        <button type="submit">Update Organization</button>
    </form>

    <p><a href="/organization/<%= organizationDetails.organization_id %>">&larr; Cancel</a></p>
</div>

<%- include('partials/footer') %>