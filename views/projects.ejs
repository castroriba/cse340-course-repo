<%- include('partials/header') %>

<div class="container">
    <h2>Service Projects</h2>
    <p>Explore current volunteer initiatives:</p>

    <% if (projects && projects.length > 0) { %>
        <ul class="projects-list" style="margin-top: 20px; line-height: 1.8;">
            <% projects.forEach(project => { %>
                <li style="margin-bottom: 12px;">
                    <strong><%= project.title %></strong> — <%= project.description %><br>
                    <small>
                        <strong>Organization:</strong> <%= project.organization_name %> | 
                        <strong>Location:</strong> <%= project.location %> | 
                        <strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString() %>
                    </small>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects found.</p>
    <% } %>
</div>

<%- include('partials/footer') %>