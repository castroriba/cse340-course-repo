<%- include('partials/header') %>

<div class="container">
    <h2>Organizations</h2>
    <p>Here are the participating community organizations:</p>
    <p><a href="/new-organization">+ Add a New Organization</a></p>

    <div class="org-list" style="display: flex; gap: 20px; margin-top: 20px; flex-wrap: wrap;">
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(org => { %>
                <div class="org-card" style="border: 1px solid #ccc; padding: 15px; border-radius: 8px; text-align: center; width: 220px;">
                    <img
                        src="<%= org.logo_url || '/images/placeholder-logo.svg' %>"
                        onerror="this.onerror=null; this.src='/images/placeholder-logo.svg';"
                        alt="<%= org.name %> Logo"
                        style="width: 100px; height: 100px; object-fit: contain;"
                    >
                    <h3 style="margin-top: 10px;">
                        <a href="/organization/<%= org.organization_id %>"><%= org.name %></a>
                    </h3>
                    <p><%= org.description %></p>
                    <p><small>Contact: <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a></small></p>
                </div>
            <% }) %>
        <% } else { %>
            <p>No organizations found.</p>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>