<%- include('partials/header') %>

<div class="container">
    <h2><%= category.name %></h2>
    <p><a href="/edit-category/<%= category.category_id %>">Edit Category</a></p>

    <h3>Projects in this Category</h3>
    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    — <%= project.organization_name %> (<%= new Date(project.date).toLocaleDateString() %>)
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects are currently assigned to this category.</p>
    <% } %>

    <p><a href="/categories">&larr; Back to Categories</a></p>
</div>

<%- include('partials/footer') %>